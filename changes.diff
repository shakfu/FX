+		}
+
+	}
+	for (int i = 0; i < 1024; ++i)
+	{
+		mSquareArray[i] /= mMaxSqr;
+		mSawtoothArray[i] /= mMaxSaw;
+		mTriangleArray[i] /= mMaxTri;
