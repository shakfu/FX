+		float blepInit(float v)
+		{
+			// add BLEP buffer contents
+			if (lpO->nInit)
+			{
+				v+=lpO->buffer[lpO->iBuffer];
+				lpO->nInit--;
+				if (++lpO->iBuffer>=lpO->cBuffer) lpO->iBuffer=0;
+			}
+			return v;
+		}
