-// Complex Absolute Value
-inline float cabs(float x, float y)
-{
-    return sqrtf((x * x) + (y * y));
-}
-
-// Complex Exponential
-inline void cexp(float x, float y, float *zx, float *zy)
-{
-    float expx;
-
-    expx = expf(x);
-    *zx = expx * cosf(y);
-    *zy = expx * sinf(y);
-}
