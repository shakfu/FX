+#include <stdio.h>
+#include <stdlib.h>
+#include <math.h>
 
+/* Bandlimited synthesis of sawtooth by
+ * leaky integration of a DSF BLIT
+ *
+ * Emanuel Landeholm, March 2002
+ * emanuel.landeholm@telia.com
+ *
+ * Provided \"as is\".
