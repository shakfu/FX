+    template <typename T>
+    struct has_reserve
+    {
+        struct succeeds {};
+        struct fails    {};
+
+        template <typename U, void (U::*)(std::size_t)>
+        struct sfinae {};
+
+        template <typename U>
+        static succeeds test (sfinae<U, &U::reserve>*);
+
+        template <typename U>
+        static fails test (...);
+
+        static constexpr bool value =
+            std::is_same<decltype(test<T>(0)), succeeds>::value;
+    };
+
+    template <typename T>
+    struct memblock
+    {
+        alignas (alignof(T)) unsigned char data[sizeof(T)];
+    };
