+
+  /* sweep from 40 to 20000 Hz */
+
+  cps = 40.0 / 44100.0;
+  cm = pow(500.0, 1.0 / (double)L);
+
+  for(i = 0; i < L; ++i)
+    {
+      x = 2.0 * update_blit(&b, cps);
+      ADC_out(x);
+
+      cps *= cm;
+    }
