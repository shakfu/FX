-    public:
-        TMinBlepPulseOscillator();
-
-        /* pw = 0 --> 50% duty cycle
-        * pw = 1 --> 100% duty cycle */
-        void SetPulseWidth(DspFloatType pw)
-        {
-            NextPw = clamp(pw, 0.0f, 0.95f);
-        }
