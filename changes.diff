+
+      if(b->phase >= 1.0)
+b->phase -= 1.0;
+
+      b->curcps = cps;        /* this cycle\'s frequency */
+      b->curper = 1.0 / cps;  /* this cycle\'s period */
+
+      P2 = b->curper / 2.0;
+      b->N = 1.0 + floor(P2); /* # of partials incl. dc */
+
+      /* find the roll-off parameter which gives
+       * the desired attenuation at nyquist
