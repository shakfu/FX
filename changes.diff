-            if (lastpos > PhaseAccumulator) {
-                const int offset = PhaseAccumulator / pace * MinBLEP::overSampling;
-                for (int i = 0; i < BufferLen; i++) {
-                    Buffer[(BufferPos + i) % BufferLen] += MinBLEP::table[i
-                            * MinBLEP::overSampling + offset];
-                }
-                Target = 1;
