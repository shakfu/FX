+
+	typedef enum
+	{
+		OT_SAW,
+		OT_RSAW,
+		OT_SQUARE,
+		OT_TRIANGLE,
+	} oscwave_t;
+
+	typedef struct
+	{
+		DspFloatType f; // frequency
+		DspFloatType p; // phase
+		DspFloatType v; // output
+		
+		DspFloatType triangle;
+		DspFloatType saw;
+		DspFloatType rsaw;
+		DspFloatType square;
+		DspFloatType sine;
+
+		bool bSync;		// hardsync on/off
+		DspFloatType fSync;	// hardsync frequency
+		DspFloatType fPWM;		// pulse width
+		DspFloatType s_rate;
+
+		oscwave_t type; // square or saw
+		
+		DspFloatType *buffer; // circular output buffer
+		int cBuffer;	// buffer size
+		int iBuffer;	// current buffer position
+		int nInit;		// amount of initialized entries
+	} osc_t;
+
+
+	struct minBLEP
+	{
+
+		minBLEP(DspFloatType sampleRate) {                
+			sr = sampleRate;
+			fc = 440.0f;
+			lpO = osc_Create(sampleRate);
+			lpO->f = fc;        
+			block.setFc(10/sampleRate);
+		}    
+		~minBLEP() {
+			osc_Free(lpO);
+			
+		}
+		void setFrequency(DspFloatType f)
+		{   
+		
+			lpO->f = f;       
+			//lpO->triangle = 0;
+		}
+		void setWaveform(oscwave_t type)
+		{        
+			lpO->type = type;        
+		}
+		DspFloatType Tick(DspFloatType I=0,DspFloatType A=1, DspFloatType X=0, DspFloatType Y=0)
+		{
+			return osc_Play(lpO);
+		}
+		
+		// call when main oscillator resets
+		void syncSlave()
+		{        
+			if(lpS == NULL) return;
+			/*
+			DspFloatType fs=lpO->f / lpO->s_rate;
+			lpS->v=0.0f;        
+			osc_AddBLEP(lpS, lpS->p/fs,1.0f);
+			
+			
+			// add BLEP at sync
+			if (lpS->type >=OT_SQUARE)
+			{
+				lpS->v=1.0f;
+				lpS->triangle = 0.0f;
+				osc_AddBLEP(lpS, (lpS->p-lpS->fPWM)/fs,-1.0f);
+			} 
+			*/   
+			lpS->p=0;
+		}
+
+		void setSlave(osc_t * o)
+		{
+			lpS = o;
+		}
+
+		DspFloatType blepInit(DspFloatType v)
+		{
+			// add BLEP buffer contents
+			if (lpO->nInit)
+			{
+				v+=lpO->buffer[lpO->iBuffer];
+				lpO->nInit--;
+				if (++lpO->iBuffer>=lpO->cBuffer) lpO->iBuffer=0;
+			}
+			return v;
+		}
+		OnePole block;
+		DspFloatType fc,sr;
+		osc_t* lpO;
+		osc_t* lpS;
+		
+		DspFloatType  osc_Play(osc_t *lpO);
+		void    osc_AddBLEP(osc_t *lpO, DspFloatType offset, DspFloatType amp);
+		osc_t*  osc_Create(DspFloatType rate);
+		void    osc_Free(osc_t * lp);
+	};
+
+	inline void minBLEP::osc_Free(osc_t * lp)
+	{
+		if(lp->buffer) free(lp->buffer);
+		free(lp);
+	}
+
+	inline osc_t* minBLEP::osc_Create(DspFloatType rate)
+	{
+		osc_t *lpO=(osc_t*)malloc(sizeof(osc_t));
+
+		// frequency
+		lpO->f=440;
+		lpO->p=0;
+		lpO->v=0;
+
+		// stuff
+		lpO->bSync=false;
+		lpO->fPWM=0.5;
+		lpO->type=OT_SAW;
+		lpO->s_rate = rate;
+
+		// buffer
+		lpO->cBuffer = 1024; //gMinBLEP.c/KTABLE;
+		lpO->buffer=(DspFloatType*)malloc(sizeof(DspFloatType)*lpO->cBuffer);
+		lpO->iBuffer=0;
+		lpO->nInit=0;
+
+		return lpO;
+	}
+
+	#define LERP(A,B,F) ((B-A)*F+A)
+
+	//----------------------------------------------------------
+
+	// add impulse into buffer
+	void minBLEP::osc_AddBLEP(osc_t *lpO, DspFloatType offset, DspFloatType amp)
+	{
+		int i;
+		DspFloatType *lpOut=lpO->buffer+lpO->iBuffer;
+		const DspFloatType *lpIn=minBlep_Table+(uint32_t)(KTABLE*offset);
+		DspFloatType  frac=fmod(KTABLE*offset,1.0);
+		int     cBLEP=(2048/KTABLE)-1;
+		DspFloatType *lpBufferEnd=lpO->buffer+lpO->cBuffer;
+		DspFloatType f;
+
+		// add
+		for (i=0; i<lpO->nInit; i++, lpIn+=KTABLE, lpOut++)
+		{
+			if (lpOut>=lpBufferEnd) lpOut=lpO->buffer;
+			f=LERP(lpIn[0],lpIn[1],frac);
+			*lpOut+=amp*(1-f);
+		}
+
+		// copy
+		for (; i<cBLEP; i++, lpIn+=KTABLE, lpOut++)
+		{
+			if (lpOut>=lpBufferEnd) lpOut=lpO->buffer;
+			f=LERP(lpIn[0],lpIn[1],frac);
+			*lpOut=amp*(1-f);
+		}
+
+		lpO->nInit=cBLEP;
+	}
+
+	//----------------------------------------------------------
+	/*
+	DspFloatType sign(DspFloatType x) {
+		if(x < 0) return -1;
+		return 1;
+	}
+	*/
+
+	// play waveform
+	DspFloatType minBLEP::osc_Play(osc_t *lpO)
+	{
+		DspFloatType v;
+		DspFloatType fs=lpO->f / lpO->s_rate;
+		static DspFloatType phase = 0;
+
+		// create waveform
+		lpO->p=lpO->p+fs;
+			
+		// add BLEP at end of waveform
+		if (lpO->p>=1)
+		{        
+			lpO->p=lpO->p-1.0;
+			lpO->v=0.0f;        
+			osc_AddBLEP(lpO, lpO->p/fs,1.0f);
+			syncSlave();
+		}
+		
+		// add BLEP in middle of wavefor for squarewave
+		if (!lpO->v && lpO->p>lpO->fPWM && lpO->type >=OT_SQUARE)
+		{
+			lpO->v=1.0f;
+			//lpO->triangle = 0.0f;
+			osc_AddBLEP(lpO, (lpO->p-lpO->fPWM)/fs,-1.0f);
+		}
+
+		// these fruities are only positive 
+		lpO->saw    = lpO->p;     
+		lpO->rsaw   = 1.0-lpO->saw;
+		lpO->square = lpO->v;
+		
+
+		// sample value
+		if (lpO->type==OT_SAW)
+		{
+			v = lpO->saw;    		
+		}
+		else if(lpO->type == OT_RSAW)
+		{
+			v = lpO->rsaw;		
+		}
+		else
+		{
+			v = lpO->square;		
+		}
+
+		v=blepInit(v);
+
+		// it's not entirely stable
+		lpO->triangle += (2*v-1)*fs/4.0;
+		lpO->triangle -= block.process(lpO->triangle);
+		if (lpO->type==OT_TRIANGLE)
+			return 8*(lpO->triangle);
+
+		return 2*v-1;
+	}
+
+}
+#undef KTABLE
+#undef LERP
