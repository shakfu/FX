+
+static int clipped = 0;
+
+static void ADC_out(double x)
+{
+  short s;
+
+  if(x > 1.0)
+    {
+      ++clipped;
+      x = 1.0;
+    }
+  else if(x < -1.0)
+    {
+      ++clipped;
+      x = -1.0;
+    }
+
+  s = 32767.0 * x;
+
+  fwrite(&s, sizeof(s), 1, stdout);
