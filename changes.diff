+			double n = static_cast<double> (g);
+			mSquareArray[i] += static_cast<float>((1.0 / n) * sin(2.0 * M_PI * i * n / 1024.0));
+		}
+		if (i == 0)
+		{
+			mMaxSqr = mSquareArray[i];
+			mMaxSaw = mSawtoothArray[i];
+			mMaxTri = mTriangleArray[i];
+		}
+		else
