-
-        DspFloatType Tick()
-        {
-            DspFloatType A = 1.0;
-            DspFloatType outs = 0;
-            DspFloatType pace = Hz / sampleRate;
-
-            
-            assert(pace > 0);
-            if (pace > 0.99) pace = 0.99;
-
-            DspFloatType lastpos = PhaseAccumulator;
-            PhaseAccumulator += pace;
-            if (PhaseAccumulator >= 1) {
-                PhaseAccumulator -= 1;
-                Pw = NextPw;
-            }
-            
-
-            const DspFloatType pw = 0.5 + 0.5 * Pw;
-            assert(PhaseAccumulator >= 0);
-            assert(PhaseAccumulator <= 1);
