-            si = -sinf(p);
-            realTime[k] += (realFreq[i] * sr) + (imagFreq[i] * si);
-            imagTime[k] += (realFreq[i] * si) - (imagFreq[i] * sr);
-        }
-        realTime[k] /= n;
-        imagTime[k] /= n;
-    }
